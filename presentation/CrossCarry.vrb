\frametitle{Events}
\vfill
\begin{enumerate}
    \item \textbf{31 SIMPOSIO INTERNACIONAL DE ESTADÍSTICA}: Modelamiento semiparametrico de efectos carryover en diseños crossover con medidas repetidas, Manizales, Colombia, 29 de Agosto a 2 de Septiembre de 2022.

\item \textbf{JORNADA AVANCES EN MÉTODOS ESTADISTICOS}: Una estructura de correlación de Kronecker para el análisis de respuestas en diseños experimentales crossover con GEE, 16 y 17 de febrero de 2023.
\item \textbf{XIX Conferencia Española de Biometría (CEB) y  VIII Encuentro Iberoamericano de Biometría (EIB)}:   Semi-parametric generalized estimating equations for repeated measurements in crossover designs,  27 al 30 de Junio de 2023, Vigo, Galicia, España.
\end{enumerate}

